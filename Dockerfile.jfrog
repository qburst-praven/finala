FROM golang:1.22-bookworm

# Install Node.js, npm, build tools, unzip, and 7z
RUN apt-get update && apt-get install -y \
    curl ca-certificates gnupg unzip p7zip-full nodejs npm \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install JFrog CLI
RUN curl -fkL https://install-cli.jfrog.io | sh

WORKDIR /app
